# OpenAlex
# Recommended and expected for normal relevantpaper runs.
# OpenAlex is the primary backend for metadata, citation expansion, related works,
# semantic search, OA status, and PDF URL signals.
OPENALEX_API_KEY=

# Semantic Scholar
# Optional. If present, use authenticated requests.
# If absent, use unauthenticated/public endpoints where possible and fail softly.
SEMANTIC_SCHOLAR_API_KEY=

# Crossref
# Optional but recommended. Crossref works without signup/authentication.
# If set, use mailto parameter or agent/User-Agent header for polite pool.
CROSSREF_MAILTO=

# Optional. Only for Crossref Metadata Plus subscribers.
CROSSREF_PLUS_API_TOKEN=

# relevantpaper defaults
RELEVANTPAPER_MAX_CANDIDATES=200
RELEVANTPAPER_MAX_DOWNLOADS=40
RELEVANTPAPER_CACHE_DIR=.readingpaper/cache

# MinerU
# Required for full MinerU cloud parsing.
# Used to parse seed PDFs and selected relevant PDFs into structured text,
# formulas, tables, figures, and metadata.
MINERU_API_TOKEN=

# Optional.
# Maximum number of relevant papers to send through MinerU.
RELEVANTPAPER_MAX_MINERU_PARSE=8

# Optional.
# Set true to parse only the seed paper deeply and use metadata for relevant papers.
RELEVANTPAPER_SKIP_MINERU_FOR_RELEVANT=false

# Optional.
# full = requires full zip output.
# lightweight = markdown-only fallback, not acceptable for final deep reports.
MINERU_PARSE_MODE=full
